@import "~/.config/rofi/colors/colors.rasi"
@import "~/.config/rofi/colors/radius.rasi"

/* ── Window ────────────────────────────────────────────────────────────
 * Compact launcher (6 fixed options). No wallpaper banner — items speak
 * for themselves. */
window {
  width: 16em;
  padding: 0px;
  border: 2px;
  border-color: var(primary);
  border-radius: var(borderradius);
  transparency: "real";
  background-color: var(surface-container);
}

mainbox {
  background-color: transparent;
  spacing: 0px;
  padding: 10px;
  children: [ "listview" ];
}

listview {
  lines: 6;
  columns: 1;
  fixed-columns: true;
  fixed-height: true;
  margin: 0px;
  padding: 0px;
  background-color: transparent;
  scrollbar: false;
  cycle: false;
  border: 0px;
  spacing: 4px;
}

element {
  padding: 8px 12px;
  orientation: horizontal;
  margin: 0px;
  border-radius: var(buttonradius);
  border: 1px;
  border-color: var(outline-variant);
  background-color: var(surface-container-high);
}

element normal.normal,
element normal.active,
element normal.urgent,
element alternate.normal,
element alternate.active,
element alternate.urgent {
  background-color: var(surface-container-high);
  text-color: var(on-surface);
}

element selected.normal,
element selected.active,
element selected.urgent {
  background-color: var(primary-container);
  text-color: var(on-primary-container);
  border: 1px;
  border-color: var(primary);
}

element-text {
  background-color: transparent;
  text-color: inherit;
  padding: 0em;
  vertical-align: 0.5;
  highlight: bold underline;
}

element-icon {
  size: 1.2em;
  background-color: transparent;
  text-color: inherit;
}

error-message {
  enabled: true;
  padding: 0.8em;
  background-color: var(surface-container);
  border-color: var(error);
  border-radius: var(borderradius);
}

textbox {
  enabled: true;
  padding: 0.3em 0.45em;
  str: "No results found";
  text-color: var(on-error-container);
  background-color: var(error-container);
  border-radius: var(buttonradius);
}
