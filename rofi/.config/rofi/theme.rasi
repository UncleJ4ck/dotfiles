@import "~/.config/rofi/colors/colors.rasi"
@import "~/.config/rofi/colors/radius.rasi"

window {
  width: 500px;
  padding: 15px;
  border: 0px;
  border-color: var(primary);
  border-radius: var(borderradius);
  transparency: "real";
  background-color: var(surface);
  x-offset: 0px;
  y-offset: 0px;
}

error-message {
  enabled: true;
  padding: 0.8em;
  background-color: transparent;
  border-color: var(primary);
  border-radius: var(borderradius);
}

textbox {
  enabled: true;
  padding: 0.4em 0.54em 0.4em 0.54em;
  str: "No results!";
  text-color: var(error);
  background-color: var(surface-container);
  border-radius: var(buttonradius);
  border-color: var(primary);
}

entry {
  hide-cursor-on-empty: true;
  placeholder: " Search...";
  placeholder-color: var(secondary);
  text-color: var(secondary);
  border: 0em;
  border-color: var(primary);
  padding: 0.4em 0.54em 0.4em 0.54em;
  border-radius: var(buttonradius);
  background-color: var(surface-container);
}

listview {
  lines: 4;
  margin: 0px;
  padding: 10px 0px 0px 0px;
  columns: 4;
  fixed-columns: true;
  fixed-height: true;
  background-color: transparent;
  scrollbar: false;
  cycle: false;
  border: 0px;
  border-color: var(primary);
  spacing: 5px;
}

mainbox {
  background-color: transparent;
  spacing: 0em;
  padding: 0.6em;
  border-radius: var(borderradius);
  children: [ inputbar, listview ];
}

inputbar {
  padding: 0em;
  background-color: transparent;
  children: [ entry ];
  border: 0em;
  border-color: var(primary);
}

element {
  padding: 10px 5px;
  orientation: vertical;
  margin: 2px;
  border-radius: var(buttonradius);
  border: 0px;
}

element normal.normal {
  background-color: transparent;
  text-color: var(secondary);
}

element normal.active {
  background-color: transparent;
  text-color: var(secondary);
}

element normal.urgent {
  background-color: transparent;
  text-color: var(secondary);
}

element alternate.active {
  background-color: transparent;
  text-color: var(secondary);
}

element alternate.normal {
  background-color: transparent;
  text-color: var(secondary);
}

element alternate.urgent {
  background-color: transparent;
  text-color: var(secondary);
}

element-text {
  background-color: #00000000;
  text-color: inherit;
  padding: 0em;
  horizontal-align: 0.5;
  highlight: bold underline;
}

element selected.normal {
  background-color: var(surface-container-highest);
  text-color: var(secondary);
  border: 0em;
  border-color: var(primary);
}

element-icon {
  size: 48px;
  background-color: transparent;
  text-color: inherit;
}
