@import "~/.config/rofi/colors/colors.rasi"
@import "~/.config/rofi/colors/radius.rasi"

/* ============================================================================
 * Rofi main drun — Material You (matugen) redesign
 *
 * Compact app grid without the oversized wallpaper banner. Search bar at the
 * top, 4×4 tiles below. Selection uses primary-container fill (matches the
 * active-workspace treatment in waybar).
 * ========================================================================== */

* {
  font: "JetBrainsMono Nerd Font Propo 13";
}

window {
  width: 640px;
  padding: 0px;
  border: 2px;
  border-color: var(primary);
  border-radius: var(borderradius);
  transparency: "real";
  background-color: var(surface-container);
}

mainbox {
  background-color: transparent;
  spacing: 0px;
  padding: 10px;
  children: [ "inputbar", "listview" ];
}

inputbar {
  background-color: transparent;
  padding: 0px 0px 8px 0px;
  children: [ "entry" ];
  spacing: 0px;
}

entry {
  expand: true;
  background-color: var(surface-container-highest);
  border: 1px;
  border-color: var(outline-variant);
  border-radius: var(buttonradius);
  padding: 8px 12px;
  min-height: 36px;
  placeholder: "  Search apps…";
  placeholder-color: var(on-surface-variant);
  text-color: var(on-surface);
  horizontal-align: 0.0;
  vertical-align: 0.5;
}

listview {
  lines: 4;
  columns: 4;
  fixed-columns: true;
  fixed-height: true;
  margin: 0px;
  padding: 0px;
  background-color: transparent;
  scrollbar: false;
  cycle: false;
  border: 0px;
  spacing: 6px;
}

element {
  padding: 10px 6px;
  orientation: vertical;
  margin: 0px;
  border-radius: var(buttonradius);
  border: 1px;
  border-color: var(outline-variant);
  background-color: var(surface-container-high);
}

element normal.normal,
element normal.active,
element normal.urgent,
element alternate.normal,
element alternate.active,
element alternate.urgent {
  background-color: var(surface-container-high);
  text-color: var(on-surface);
}

element selected.normal,
element selected.active,
element selected.urgent {
  background-color: var(primary-container);
  text-color: var(on-primary-container);
  border: 1px;
  border-color: var(primary);
}

element-text {
  background-color: transparent;
  text-color: inherit;
  padding: 6px 0px 0px 0px;
  horizontal-align: 0.5;
  vertical-align: 0.5;
  highlight: bold underline;
}

element-icon {
  size: 40px;
  background-color: transparent;
  text-color: inherit;
}

error-message {
  enabled: true;
  padding: 0.8em;
  background-color: var(surface-container);
  border-color: var(error);
  border-radius: var(borderradius);
}

textbox {
  enabled: true;
  padding: 0.6em 0.75em;
  str: "No results found";
  text-color: var(on-error-container);
  background-color: var(error-container);
  border-radius: var(buttonradius);
}
