#!/bin/bash
# /etc/initcpio/install/keymap-xkb
#
# Build-time hook for mkinitcpio. Reads XKBLAYOUT/XKBVARIANT/XKBMODEL/XKBOPTIONS
# from /etc/vconsole.conf and bakes them into /etc/keymap-xkb.env inside the
# initramfs, so the runtime hook can export XKB_DEFAULT_* before plymouthd
# starts. Result: Plymouth's libxkbcommon-driven LUKS prompt uses the user's
# keyboard layout instead of falling back to "us".
#
# Source of truth: /etc/vconsole.conf (managed by `localectl set-x11-keymap`).

build() {
    local layout="" variant="" model="" options=""

    if [[ -r /etc/vconsole.conf ]]; then
        # /etc/vconsole.conf is plain KEY=VALUE; safe to source.
        # shellcheck disable=SC1091
        . /etc/vconsole.conf
        layout="${XKBLAYOUT:-}"
        variant="${XKBVARIANT:-}"
        model="${XKBMODEL:-}"
        options="${XKBOPTIONS:-}"
    fi

    if [[ -z "$layout" ]]; then
        warning "keymap-xkb: XKBLAYOUT not set in /etc/vconsole.conf; hook is a no-op"
        return 0
    fi

    add_runscript

    install -d -m 755 "$BUILDROOT/etc"
    cat >"$BUILDROOT/etc/keymap-xkb.env" <<EOF
# Generated by /etc/initcpio/install/keymap-xkb at mkinitcpio build time.
# Source: /etc/vconsole.conf
XKB_DEFAULT_LAYOUT=$layout
XKB_DEFAULT_VARIANT=$variant
XKB_DEFAULT_MODEL=$model
XKB_DEFAULT_OPTIONS=$options
EOF
    chmod 644 "$BUILDROOT/etc/keymap-xkb.env"
}

help() {
    cat <<HELPEOF
Exports XKB_DEFAULT_LAYOUT/VARIANT/MODEL/OPTIONS into the initramfs based on
/etc/vconsole.conf so that xkbcommon-based tools (notably plymouthd) load the
configured keyboard layout for the LUKS unlock prompt.

Place this hook BEFORE 'plymouth' in /etc/mkinitcpio.conf HOOKS, e.g.:
  HOOKS=(... keymap consolefont keymap-xkb block plymouth encrypt ...)

Removing the hook from HOOKS and re-running mkinitcpio -P fully reverts.
HELPEOF
}
